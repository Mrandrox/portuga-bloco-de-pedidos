# Copie para .env na máquina/servidor do cliente. Nunca faça commit do .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
PUBLIC_APP_ORIGIN=http://localhost:8100
MAX_REQUEST_BYTES=1048576

# OLIST — preencher somente após confirmar a documentação da edição/conta.
# Use URL HTTPS de produção/homologação fornecida oficialmente pela Olist.
OLIST_API_BASE_URL=
OLIST_API_TOKEN=
OLIST_AUTH_HEADER=Authorization
OLIST_AUTH_SCHEME=Bearer
# Caminho relativo exato da operação de catálogo, obtido na documentação.
OLIST_PRODUCTS_PATH=
# Não ativar criação de pedido até implementar e testar o mapeamento oficial.
OLIST_ORDER_CREATE_PATH=
OLIST_ORDER_CREATE_ENABLED=false

# META / WhatsApp Cloud API — manter o número atual até confirmar coexistência.
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=

# Nunca colocar OPENAI_API_KEY no aplicativo Android. Se IA for ligada, usar backend.
OPENAI_API_KEY=
