"{\n  \"name\": \"portuga-bloco-de-pedidos-windows\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"description\": \"Aplicativo Windows do Portuga \u2014 Bloco de Pedidos\",\n  \"author\": \"Portuga\",\n  \"main\": \"src/main.js\",\n  \"scripts\": {\n    \"start\": \"electron .\",\n    \"dist:win\": \"electron-builder --win nsis --x64\",\n    \"check\": \"node --check src/main.js && node --check src/preload.js && node --check src/settings.js\"\n  },\n  \"devDependencies\": {\n    \"electron\": \"45.1.0\",\n    \"electron-builder\": \"26.18.0\"\n  },\n  \"build\": {\n    \"appId\": \"com.portuga.bloco-pedidos.windows\",\n    \"productName\": \"Portuga - Bloco de Pedidos\",\n    \"asar\": true,\n    \"files\": [\"src/**/*\", \"package.json\"],\n    \"extraResources\": [\n      {\n        \"from\": \"../bloco-de-notas-android/www\",\n        \"to\": \"portuga-web\",\n        \"filter\": [\"**/*\"]\n      }\n    ],\n    \"directories\": { \"buildResources\": \"build\", \"output\": \"dist\" },\n    \"artifactName\": \"Portuga-Bloco-de-Pedidos-Setup.exe\",\n    \"win\": { \"icon\": \"build/portuga.ico\", \"target\": [{ \"target\": \"nsis\", \"arch\": [\"x64\"] }] },\n    \"nsis\": {\n      \"oneClick\": false,\n      \"allowToChangeInstallationDirectory\": true,\n      \"installerIcon\": \"build/portuga.ico\",\n      \"uninstallerIcon\": \"build/portuga.ico\",\n      \"installerHeaderIcon\": \"build/portuga.ico\",\n      \"createDesktopShortcut\": true,\n      \"createStartMenuShortcut\": true,\n      \"shortcutName\": \"Portuga - Bloco de Pedidos\",\n      \"uninstallDisplayName\": \"Portuga - Bloco de Pedidos\"\n    }\n  }\n}\n"